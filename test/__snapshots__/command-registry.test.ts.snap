exports[`declarative command registry > keeps global and per-command help under snapshots > explain help 1`] = `
"Explain a fresh or previously recorded decision without installing.

Usage:
  targate explain <package>[@version] | --last

Options:
  --last                       Explain the most recent add or approve run offline.
  --json                       Print machine-readable JSON.
  --no-cache                   Ignore cached AI assessments for this run.
  --no-ai                      Skip AI reasoning and use deterministic rules only.
  --provider <name>            Use anthropic, deepseek, openai, ollama, or custom.
  --model <name>               Override the selected provider model.
  --base-url <url>             Set the API base URL (required for a custom provider).
  --api-key <key>              Set an API key. Prefer an environment variable — a CLI value can be captured in shell history and CI logs.
  --reasoning                  Enable model reasoning where supported.
  --fail-on-osv-error          Require approval when OSV is unreachable.
  --no-reputation              Skip external reputation lookups.
  --help                       Show help for this command.

Examples:
  targate explain left-pad@1.3.0
  targate explain --last"
`;

exports[`declarative command registry > keeps global and per-command help under snapshots > global help 1`] = `
"targate — gate every dependency before it runs (AI-gated pre-install security)

Usage:
  targate add <package>[@version]                 Analyze one package, then gate its installation.
  targate approve <package>[@version]             Record a committable human approval without installing.
  targate audit <package>[@version]               AI-read a package's source for security issues, without installing.
  targate install                                 Vet the complete dependency tree, then gate a full install.
  targate sandbox <package>[@version]             Trial-install a package in a disposable Docker container.
  targate ci [init]                               Gate dependency changes against a Git ref or scaffold CI.
  targate policy init                             Scaffold a declarative team policy from a preset.
  targate proxy <start|stop|status|ensure|setup|teardown|cert|approvals|approve|deny> Run a registry proxy that vets every package before install.
  targate doctor                                  Diagnose the local security and provider environment.
  targate diff <pkg>@<v1> [<pkg>[@<v2>]]          Compare package versions and rate the upgrade risk.
  targate monitor                                 Re-check trusted packages and report increased risk. [experimental]
  targate graph [<package>[@version]]             Render a dependency risk graph or explain why a package is present. [experimental]
  targate recommend "<need>"                      Recommend analyzed packages for a need, safest first. [experimental]
  targate history [<package>[@version]]           Show recorded trust decisions and optionally verify signatures.
  targate explain <package>[@version] | --last    Explain a fresh or previously recorded decision without installing.
  targate cache <info|clear>                      Inspect or clear the AI assessment cache.
  targate agents init                             Scaffold instructions that make coding agents use targate.

Options:
  --package-manager <pm>       Force pnpm, npm, or yarn (default: auto-detect).
  --json                       Print machine-readable JSON.
  --dry-run                    Analyze and report only; never prompt or install.
  --yes                        Skip confirmation only for decisions that may be automated.
  --no-cache                   Ignore cached AI assessments for this run.
  --deep                       Analyze the full transitive dependency tree.
  --audit-code                 Run the AI source-code security audit (opt-in; expensive). Scope comes from the team policy's codeAudit (default: flagged packages).
  --concurrency <n>            Maximum parallel package analyses (default: 16).
  --no-ai-batch                Use one AI request per package instead of batching.
  --no-ai                      Skip AI reasoning and use deterministic rules only.
  --provider <name>            Use anthropic, deepseek, openai, ollama, or custom.
  --model <name>               Override the selected provider model.
  --base-url <url>             Set the API base URL (required for a custom provider).
  --api-key <key>              Set an API key. Prefer an environment variable — a CLI value can be captured in shell history and CI logs.
  --reasoning                  Enable model reasoning where supported.
  --fail-on-osv-error          Require approval when OSV is unreachable.
  --no-reputation              Skip external reputation lookups.
  --allow-scripts              Allow lifecycle scripts where the command supports it.
  --sign                       Sign an approval with the human operator's SSH key.
  --update-lockfile            Stage and review a lockfile update before installing.
  --frozen-lockfile            Deprecated no-op; immutable installs are the default.
  --image <image>              Docker image (default: node:22-alpine).
  --timeout <seconds>          Kill the sandbox after this many seconds (default: 300).
  --network <mode>             Sandbox network mode: open or none.
  --no-capture                 Disable sandbox network observation.
  --base-ref <ref>             Git ref to compare against (default: origin/main).
  --format <format>            Select the output or scaffold format.
  --preset <name>              Policy preset: default, strict, react-native, ci, or ai-agent.
  --port <n>                   Registry proxy port (default: 4873).
  --upstream <url>             Upstream registry origin (default: https://registry.npmjs.org).
  --host <addr>                Interface to bind the proxy to (default: 127.0.0.1).
  --foreground                 Run the proxy in this process instead of a background daemon.
  --tls                        Serve HTTPS with a locally generated CA/certificate.
  --ping                       Send a real provider completion during diagnostics.
  --fail-on <level>            Exit 2 at low, medium, or high diff risk (default: high).
  --all                        Include the complete lockfile dependency tree.
  --no-update                  Report monitor events without advancing the baseline.
  --output <path>              Graph output path; use - for stdout.
  --only <filters>             Keep graph nodes matching comma-separated risk filters.
  --why <package>              Print every risk-annotated dependency chain to a package.
  --open                       Open a written HTML or SVG graph in the browser.
  --limit <n>                  Maximum recommendation candidates (default: 5, maximum: 15).
  --verify                     Verify approval signatures against allowed signers.
  --last                       Explain the most recent add or approve run offline.
  --scope <scope>              Cache scope: user or project.
  -h, --help                  Show global or command-specific help.
  -v, --version               Print the targate version.

Run \`targate <command> --help\` for command-specific options and examples."
`;

exports[`declarative command registry > keeps global and per-command help under snapshots > graph help 1`] = `
"Render a dependency risk graph or explain why a package is present.

[experimental] Outside the 1.0 stability guarantee — flags and output may change in a minor release.

Usage:
  targate graph [<package>[@version]]

Options:
  --format <format>            Select the output or scaffold format.
  --output <path>              Graph output path; use - for stdout.
  --only <filters>             Keep graph nodes matching comma-separated risk filters.
  --why <package>              Print every risk-annotated dependency chain to a package.
  --open                       Open a written HTML or SVG graph in the browser.
  --json                       Print machine-readable JSON.
  --package-manager <pm>       Force pnpm, npm, or yarn (default: auto-detect).
  --no-reputation              Skip external reputation lookups.
  --fail-on-osv-error          Require approval when OSV is unreachable.
  --concurrency <n>            Maximum parallel package analyses (default: 16).
  --help                       Show help for this command.

Examples:
  targate graph
  targate graph --only high-risk,scripts
  targate graph --why minimist"
`;

exports[`declarative command registry > keeps global and per-command help under snapshots > history help 1`] = `
"Show recorded trust decisions and optionally verify signatures.

Usage:
  targate history [<package>[@version]]

Options:
  --json                       Print machine-readable JSON.
  --verify                     Verify approval signatures against allowed signers.
  --help                       Show help for this command.

Examples:
  targate history
  targate history esbuild --verify"
`;

