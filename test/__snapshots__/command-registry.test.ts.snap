exports[`declarative command registry > keeps global and per-command help under snapshots > proxy help 1`] = `
"Run a registry proxy that vets every package before install.

Usage:
  targate proxy <start|stop|status|ensure|setup|teardown|cert|approvals|approve|deny>

Options:
  --port <n>                   Registry proxy port (default: 4873).
  --upstream <url>             Upstream registry origin (default: https://registry.npmjs.org).
  --host <addr>                Interface to bind the proxy to (default: 127.0.0.1).
  --foreground                 Run the proxy in this process instead of a background daemon.
  --tls                        Serve HTTPS with a locally generated CA/certificate.
  --dry-run                    Analyze and report only; never prompt or install.
  --help                       Show help for this command.

Examples:
  targate proxy setup
  targate proxy status
  targate proxy approve lodash@4.17.21"
`;

