// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`declarative command registry > keeps global and per-command help under snapshots > add help 1`] = `
"Analyze one package, then gate its installation.

Usage:
  targate add <package>[@version]

Options:
  --package-manager <pm>       Force pnpm, npm, or yarn (default: auto-detect).
  --json                       Print machine-readable JSON.
  --dry-run                    Analyze and report only; never prompt or install.
  --yes                        Skip confirmation only for decisions that may be automated.
  --no-cache                   Ignore cached AI assessments for this run.
  --deep                       Analyze the full transitive dependency tree.
  --audit-code                 Run the AI source-code security audit (opt-in; expensive). Scope comes from the team policy's codeAudit (default: flagged packages).
  --concurrency <n>            Maximum parallel package analyses (default: 16).
  --no-ai-batch                Use one AI request per package instead of batching.
  --no-ai                      Skip AI reasoning and use deterministic rules only.
  --provider <name>            Use anthropic, deepseek, openai, ollama, or custom.
  --model <name>               Override the selected provider model.
  --base-url <url>             Set the API base URL (required for a custom provider).
  --api-key <key>              Set an API key. Prefer an environment variable — a CLI value can be captured in shell history and CI logs.
  --reasoning                  Enable model reasoning where supported.
  --fail-on-osv-error          Require approval when OSV is unreachable.
  --no-reputation              Skip external reputation lookups.
  --help                       Show help for this command.

Examples:
  targate add lodash
  targate add left-pad@1.3.0 --dry-run
  targate add esbuild --yes --deep"
`;

exports[`declarative command registry > keeps global and per-command help under snapshots > agents help 1`] = `
"Scaffold instructions that make coding agents use targate.

Usage:
  targate agents init

Options:
  --format <format>            Select the output or scaffold format.
  --help                       Show help for this command.

Examples:
  targate agents init
  targate agents init --format all"
`;

exports[`declarative command registry > keeps global and per-command help under snapshots > approve help 1`] = `
"Record a committable human approval without installing.

Usage:
  targate approve <package>[@version]

Options:
  --json                       Print machine-readable JSON.
  --yes                        Skip confirmation only for decisions that may be automated.
  --allow-scripts              Allow lifecycle scripts where the command supports it.
  --sign                       Sign an approval with the human operator's SSH key.
  --no-cache                   Ignore cached AI assessments for this run.
  --deep                       Analyze the full transitive dependency tree.
  --audit-code                 Run the AI source-code security audit (opt-in; expensive). Scope comes from the team policy's codeAudit (default: flagged packages).
  --no-ai                      Skip AI reasoning and use deterministic rules only.
  --provider <name>            Use anthropic, deepseek, openai, ollama, or custom.
  --model <name>               Override the selected provider model.
  --base-url <url>             Set the API base URL (required for a custom provider).
  --api-key <key>              Set an API key. Prefer an environment variable — a CLI value can be captured in shell history and CI logs.
  --reasoning                  Enable model reasoning where supported.
  --fail-on-osv-error          Require approval when OSV is unreachable.
  --no-reputation              Skip external reputation lookups.
  --help                       Show help for this command.

Examples:
  targate approve esbuild@0.27.3
  targate approve esbuild@0.27.3 --sign"
`;

