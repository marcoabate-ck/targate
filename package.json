{
  "name": "targate",
  "version": "0.1.0",
  "description": "targate — gate every dependency before it runs: AI-gated pre-install security analysis for npm packages, built around React Native teams' needs",
  "type": "module",
  "bin": {
    "targate": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "benchmark": "node --import tsx benchmarks/milestone5.ts",
    "dev": "tsx src/cli.ts",
    "docs:check": "node --import tsx scripts/check-docs.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "jiti": "^2.7.0",
    "openai": "^6.45.0",
    "tar": "^7.4.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsx": "^4.23.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "keywords": [
    "security",
    "supply-chain",
    "react-native",
    "npm",
    "pre-install"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.1.2+sha512.415a1cc25974731e75455c1468371be74c5aa5fb7621b50d4056d222451609f11412f23fd602e6169f1e060466641f798597e1be961a10688836a67b16569499"
}
